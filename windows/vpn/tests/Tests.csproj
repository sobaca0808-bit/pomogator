<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="ui/**/*.cs" />
    <Compile Include="../app/TunSession.cs" Link="TunSession.cs" />
    <Compile Include="../app/LocalData.cs" Link="LocalData.cs" />
    <Compile Include="../app/TunControlProbe.cs" Link="TunControlProbe.cs" />
    <Compile Include="../app/TunTraffic.cs" Link="TunTraffic.cs" />
    <Compile Include="../app/TunPacketCounters.cs" Link="TunPacketCounters.cs" />
    <Compile Include="../app/TunXrayCounters.cs" Link="TunXrayCounters.cs" />
    <Compile Include="../app/TunConnectivity.cs" Link="TunConnectivity.cs" />
    <Compile Include="../app/TunEngineDiagnostic.cs" Link="TunEngineDiagnostic.cs" />
    <Compile Include="../app/TunReadiness.cs" Link="TunReadiness.cs" />
    <Compile Include="../app/TunWindows.cs" Link="TunWindows.cs" />
    <Compile Include="../app/TunConsole.cs" Link="TunConsole.cs" />
    <ProjectReference Include="../core/Core.csproj" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
    <Compile Include="../app/RasProxyScope.cs" Link="RasProxyScope.cs" />
    <Compile Include="../app/WinInet.cs" Link="WinInet.cs" />
    <Compile Include="../app/WindowsLifetime.cs" Link="WindowsLifetime.cs" />
  </ItemGroup>
</Project>
