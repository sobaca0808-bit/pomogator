index 0000000..258f829
--- /dev/null
+++ b/proxy/tun/pomogator_windows.go
@@ -0,0 +1,95 @@
+package tun
+
+import (
+	"encoding/binary"
+	"errors"
+	"net/netip"
+	"os"
+	"runtime"
+	"strconv"
+	"unsafe"
+
+	"golang.org/x/sys/windows"
+	"golang.zx2c4.com/wireguard/windows/tunnel/winipcfg"
+)
+
+// Windows SDK fwpmu.h. ALE_ORIGINAL_APP_ID is available at ALE_AUTH_CONNECT_V4
+// from Windows 8. WFP can report a redirector as the current application.
+var (
+	fwpmConditionALEOriginalAppID = windows.GUID{Data1: 0x0e6cd086, Data2: 0xe1fb, Data3: 0x4212, Data4: [8]byte{0x84, 0x2f, 0x8a, 0x9f, 0x99, 0x3f, 0xb3, 0xf6}}
+	fwpmConditionIPLocalAddress   = windows.GUID{Data1: 0xd9ee00de, Data2: 0xc1ef, Data3: 0x4617, Data4: [8]byte{0xbf, 0xe3, 0xff, 0xd8, 0xf5, 0xa0, 0x89, 0x57}}
+)
+
+type pomogatorPeer struct {
+	server   netip.AddrPort
+	source   netip.Addr
+	uplink   winipcfg.LUID
+	protocol uint8
+}
+
+func readPomogatorPeer(tun winipcfg.LUID) (pomogatorPeer, error) {
+	server, err := netip.ParseAddrPort(os.Getenv("POMOGATOR_TUN_PEER"))
+	if err != nil || !server.Addr().Is4() || !server.Addr().IsGlobalUnicast() || server.Port() == 0 {
+		return pomogatorPeer{}, errors.New("invalid TUN peer endpoint")
+	}
+	source, err := netip.ParseAddr(os.Getenv("POMOGATOR_TUN_SOURCE"))
+	if err != nil || !source.Is4() || !source.IsGlobalUnicast() {
+		return pomogatorPeer{}, errors.New("invalid TUN uplink source address")
+	}
+	index, err := strconv.ParseUint(os.Getenv("POMOGATOR_TUN_IFINDEX"), 10, 32)
+	if err != nil || index == 0 {
+		return pomogatorPeer{}, errors.New("invalid TUN uplink interface index")
+	}
+	var protocol uint8
+	switch os.Getenv("POMOGATOR_TUN_PROTOCOL") {
+	case "tcp":
+		protocol = windows.IPPROTO_TCP
+	case "udp":
+		protocol = windows.IPPROTO_UDP
+	default:
+		return pomogatorPeer{}, errors.New("invalid TUN transport protocol")
+	}
+	uplink, err := winipcfg.LUIDFromIndex(uint32(index))
+	if err != nil || uplink == 0 || uplink == tun {
+		return pomogatorPeer{}, errors.New("TUN uplink interface unavailable")
+	}
+	row, err := uplink.IPAddress(source)
+	if err != nil || row.DadState != winipcfg.DadStatePreferred {
+		return pomogatorPeer{}, errors.New("TUN source IPv4 is not preferred on the uplink")
+	}
+	return pomogatorPeer{server, source, uplink, protocol}, nil
+}
+
+type pomogatorAddFilter func(layer *windows.GUID, name string, flags, action uint32, weight uint8, conditions ...fwpmFilterCondition0) error
+
+func addPomogatorPeerPermits(pinner *runtime.Pinner, appID *fwpByteBlob, peer pomogatorPeer, add pomogatorAddFilter) error {
+	uplink := new(uint64)
+	*uplink = uint64(peer.uplink)
+	pinner.Pin(uplink)
+	source := peer.source.As4()
+	server := peer.server.Addr().As4()
+
+	// Separate filters express OR on application identity and AND on every
+	// network field. An unrelated application or a redirected socket whose
+	// original application is unknown receives no special permission.
+	for _, identity := range []struct {
+		field *windows.GUID
+		name  string
+	}{
+		{&fwpmConditionALEAppID, "permit verified peer"},
+		{&fwpmConditionALEOriginalAppID, "permit redirected verified peer"},
+	} {
+		err := add(&fwpmLayerALEAuthConnectV4, identity.name, 0, fwpActionPermit, weightXray,
+			condition(identity.field, fwpByteBlobType, uintptr(unsafe.Pointer(appID))),
+			condition(&fwpmConditionIPProtocol, fwpUint8, uintptr(peer.protocol)),
+			condition(&fwpmConditionIPRemoteAddress, fwpUint32, uintptr(binary.BigEndian.Uint32(server[:]))),
+			condition(&fwpmConditionIPRemotePort, fwpUint16, uintptr(peer.server.Port())),
+			condition(&fwpmConditionIPLocalAddress, fwpUint32, uintptr(binary.BigEndian.Uint32(source[:]))),
+			condition(&fwpmConditionIPLocalInterface, fwpUint64, uintptr(unsafe.Pointer(uplink))),
+			condition(&fwpmConditionIPNexthopInterface, fwpUint64, uintptr(unsafe.Pointer(uplink))))
+		if err != nil {
+			return err
+		}
+	}
+	return nil
+}
