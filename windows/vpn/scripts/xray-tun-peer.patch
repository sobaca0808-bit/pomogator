index 0000000..368460c
--- /dev/null
+++ b/proxy/tun/pomogator_windows_test.go
@@ -0,0 +1,110 @@
+package tun
+
+import (
+	"net/netip"
+	"runtime"
+	"testing"
+	"unsafe"
+
+	"golang.org/x/sys/windows"
+	"golang.zx2c4.com/wireguard/windows/tunnel/winipcfg"
+)
+
+func TestPomogatorPeerRequiresExplicitScope(t *testing.T) {
+	for _, c := range []struct{ peer, source, index, protocol, want string }{
+		{"", "", "", "tcp", "invalid TUN peer endpoint"},
+		{"[2001:db8::1]:443", "192.0.2.33", "7", "tcp", "invalid TUN peer endpoint"},
+		{"192.0.2.10:0", "192.0.2.33", "7", "tcp", "invalid TUN peer endpoint"},
+		{"192.0.2.10:443", "0.0.0.0", "7", "tcp", "invalid TUN uplink source address"},
+		{"192.0.2.10:443", "192.0.2.33", "0", "tcp", "invalid TUN uplink interface index"},
+		{"192.0.2.10:443", "192.0.2.33", "7", "", "invalid TUN transport protocol"},
+		{"192.0.2.10:443", "192.0.2.33", "7", "any", "invalid TUN transport protocol"},
+	} {
+		t.Setenv("POMOGATOR_TUN_PEER", c.peer)
+		t.Setenv("POMOGATOR_TUN_SOURCE", c.source)
+		t.Setenv("POMOGATOR_TUN_IFINDEX", c.index)
+		t.Setenv("POMOGATOR_TUN_PROTOCOL", c.protocol)
+		if _, err := readPomogatorPeer(0); err == nil || err.Error() != c.want {
+			t.Fatalf("invalid scope error = %v, want %s", err, c.want)
+		}
+	}
+}
+
+// Inspect the native conditions supplied to BFE, including both identities.
+// All seven fields are required on each permit; no unconstrained second rule.
+func TestPomogatorPeerFilterScope(t *testing.T) {
+	for name, protocol := range map[string]uint8{"tcp": windows.IPPROTO_TCP, "udp": windows.IPPROTO_UDP} {
+		t.Run(name, func(t *testing.T) { checkPomogatorPeerFilterScope(t, protocol) })
+	}
+}
+
+func checkPomogatorPeerFilterScope(t *testing.T, protocol uint8) {
+	t.Helper()
+	peer := pomogatorPeer{netip.MustParseAddrPort("192.0.2.10:8043"), netip.MustParseAddr("192.0.2.33"), 0x106, protocol}
+	blob := new(fwpByteBlob)
+	var pinner runtime.Pinner
+	pinner.Pin(blob)
+	defer pinner.Unpin()
+	identities := []windows.GUID{fwpmConditionALEAppID, fwpmConditionALEOriginalAppID}
+	calls := 0
+	err := addPomogatorPeerPermits(&pinner, blob, peer, func(layer *windows.GUID, _ string, flags, action uint32, weight uint8, conditions ...fwpmFilterCondition0) error {
+		if calls >= len(identities) || *layer != fwpmLayerALEAuthConnectV4 || flags != 0 ||
+			action != fwpActionPermit || weight != weightXray || len(conditions) != 7 {
+			t.Fatal("unexpected filter or broad permit")
+		}
+		uplinkPtr := conditions[5].conditionValue.value
+		if uplinkPtr == 0 {
+			t.Fatal("LUID is missing")
+		}
+		want := []struct {
+			field windows.GUID
+			typ   uint32
+			value uintptr
+		}{
+			{identities[calls], fwpByteBlobType, uintptr(unsafe.Pointer(blob))},
+			{fwpmConditionIPProtocol, fwpUint8, uintptr(protocol)},
+			{fwpmConditionIPRemoteAddress, fwpUint32, 0xc000020a},
+			{fwpmConditionIPRemotePort, fwpUint16, 8043},
+			{fwpmConditionIPLocalAddress, fwpUint32, 0xc0000221},
+			{fwpmConditionIPLocalInterface, fwpUint64, uplinkPtr},
+			{fwpmConditionIPNexthopInterface, fwpUint64, uplinkPtr},
+		}
+		for i, cond := range conditions {
+			if cond.fieldKey != want[i].field || cond.matchType != fwpMatchEqual ||
+				cond.conditionValue.typ != want[i].typ || cond.conditionValue.value != want[i].value {
+				t.Fatalf("condition %d on filter %d does not constrain the intended field", i, calls)
+			}
+		}
+		calls++
+		return nil
+	})
+	if err != nil || calls != len(identities) {
+		t.Fatalf("filters added: %d, error: %v", calls, err)
+	}
+}
+
+func TestPomogatorPeerNativeWFP(t *testing.T) {
+	// Windows validates the real filter keys, layers, types and weights inside
+	// an aborted transaction. Nothing becomes active on the build machine.
+	engine, err := openWFPEngine()
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer closeWFPEngine(engine)
+	if err = fwpmResult(procFwpmTransactionBegin0.Call(uintptr(engine), 0)); err != nil {
+		t.Fatal(err)
+	}
+	defer procFwpmTransactionAbort0.Call(uintptr(engine))
+	loopback, err := winipcfg.LUIDFromIndex(1)
+	if err != nil {
+		t.Fatal(err)
+	}
+	leaks, err := ExpandWfpBlockLeak([]string{"allexceptlan", "[::/0]:all", "misconfigtun"})
+	if err != nil {
+		t.Fatal(err)
+	}
+	peer := pomogatorPeer{netip.MustParseAddrPort("192.0.2.10:443"), netip.MustParseAddr("192.0.2.33"), loopback, windows.IPPROTO_TCP}
+	if err = addLeakFilters(engine, loopback, newLeakFilters(leaks, true, false), peer); err != nil {
+		t.Fatal(err)
+	}
+}
