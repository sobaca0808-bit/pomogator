<Window x:Class="Pomogator.Vpn.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ПОМОГАТОР VPN" Width="980" Height="660" MinWidth="470" MinHeight="495"
        WindowStartupLocation="CenterScreen" Background="#111E30" Foreground="{StaticResource Text}"
        FontFamily="Segoe UI" FontSize="14" UseLayoutRounding="True">
  <Grid x:Name="Shell" ClipToBounds="True">
    <Grid.Background>
      <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#101925" Offset="0"/><GradientStop Color="#1A2E44" Offset=".52"/>
        <GradientStop Color="#101B2C" Offset="1"/>
      </LinearGradientBrush>
    </Grid.Background>
    <Grid IsHitTestVisible="False" ClipToBounds="True">
      <Ellipse Width="530" Height="360" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-105,-100,0,0" Fill="#513486BA">
        <Ellipse.Effect><BlurEffect Radius="94"/></Ellipse.Effect>
      </Ellipse>
      <Ellipse Width="480" Height="310" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-150,-125" Fill="#53228889">
        <Ellipse.Effect><BlurEffect Radius="90"/></Ellipse.Effect>
      </Ellipse>
    </Grid>
    <ScrollViewer x:Name="ContentScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="23,20" MaxWidth="1250">
        <DockPanel Margin="0,0,0,18">
          <Button DockPanel.Dock="Right" Content="⚙  Настройки" Click="SettingsClick" Margin="10,0,0,0" VerticalAlignment="Center"/>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Border Width="42" Height="42" Background="#733A6E8B" BorderBrush="#9D86C6E5" CornerRadius="12" BorderThickness="1" Margin="0,0,11,0">
              <Path Width="18" Height="22" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Stroke="{StaticResource Accent}" StrokeThickness="2" StrokeLineJoin="Round"
                    Data="M9,1 L17,4 V10 Q17,17 9,21 Q1,17 1,10 V4 Z M5,10 L8,13 L13,8"/>
            </Border>
            <StackPanel VerticalAlignment="Center">
              <TextBlock FontSize="23" FontWeight="SemiBold" Text="ПОМОГАТОР VPN"/>
              <TextBlock FontSize="12" Foreground="{StaticResource Muted}" Text="Версия 0.3.8"/>
            </StackPanel>
          </StackPanel>
        </DockPanel>
        <Border x:Name="SettingsPanel" Style="{StaticResource Panel}" Visibility="Collapsed" Margin="0,0,0,15">
          <StackPanel>
            <TextBlock Text="Настройки" FontWeight="SemiBold" FontSize="17" Margin="0,0,0,10"/>
            <WrapPanel x:Name="Modes">
              <RadioButton x:Name="LocalMode" Content="Локальный прокси" IsChecked="True" Checked="ModeChanged" Margin="0,0,20,10"/>
              <RadioButton x:Name="SystemMode" Content="Системный прокси Windows" Checked="ModeChanged" Margin="0,0,20,10"/>
              <RadioButton x:Name="TunMode" Content="VPN-туннель TUN" Checked="ModeChanged" Margin="0,0,0,10"/>
            </WrapPanel>
            <TextBlock x:Name="ModeHint" TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,0,0,8"/>
            <CheckBox x:Name="LaunchWithWindows" Content="Запускать приложение в трее вместе с Windows" Click="StartupClick"/>
          </StackPanel>
        </Border>
        <Grid x:Name="Overview" SizeChanged="OverviewSizeChanged">
          <Grid.ColumnDefinitions><ColumnDefinition Width="1.15*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <Border x:Name="Hero" Style="{StaticResource Panel}" Margin="0,0,15,0" MinHeight="365">
            <StackPanel VerticalAlignment="Center">
              <Border CornerRadius="13" Padding="11,5" Background="#502D435D" HorizontalAlignment="Center" Margin="0,0,0,13">
                <StackPanel Orientation="Horizontal">
                  <TextBlock x:Name="StatusGlyph" FontFamily="Segoe UI Symbol" Margin="0,0,6,0" FontWeight="Bold"/>
                  <TextBlock x:Name="Status" AutomationProperties.LiveSetting="Polite" FontWeight="SemiBold" Text="Отключён"/>
                </StackPanel>
              </Border>
              <Grid Width="172" Height="172" Margin="0,0,0,12" HorizontalAlignment="Center">
                <Ellipse x:Name="Pulse" Margin="1" Stroke="#768EBACF" StrokeThickness="1.4" Opacity=".7"/>
                <Ellipse Margin="10" Stroke="#546F96B7" StrokeThickness="1"/>
                <Button x:Name="Connect" Click="ConnectClick" Margin="20" Padding="0" BorderThickness="2">
                  <Button.Template>
                    <ControlTemplate TargetType="Button">
                      <Border x:Name="Circle" CornerRadius="90" BorderThickness="2" BorderBrush="{TemplateBinding BorderBrush}">
                        <Border.Background>
                          <RadialGradientBrush GradientOrigin=".35,.25">
                            <GradientStop Color="#365C78" Offset="0"/><GradientStop Color="#21384F" Offset=".7"/>
                            <GradientStop Color="#14263D" Offset="1"/>
                          </RadialGradientBrush>
                        </Border.Background>
                        <Path Width="48" Height="48" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" Stroke="#D7F4FB"
                              StrokeThickness="3.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M18,3 L18,17 M10,8 A13,13 0 1 0 26,8"/>
                      </Border>
                      <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Circle" Property="Background" Value="#3A6581"/></Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Circle" Property="BorderBrush" Value="White"/></Trigger>
                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="Circle" Property="Opacity" Value=".75"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Circle" Property="Opacity" Value=".54"/></Trigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </Button.Template>
                </Button>
              </Grid>
              <TextBlock x:Name="ActionLabel" Text="Подключиться" TextAlignment="Center" FontWeight="SemiBold"/>
              <TextBlock x:Name="SelectedServer" Text="Выберите сервер" TextAlignment="Center" FontSize="20" FontWeight="SemiBold"
                         TextTrimming="CharacterEllipsis" Margin="0,10,0,2"/>
              <TextBlock x:Name="ConnectionMeta" TextAlignment="Center" TextWrapping="Wrap" Foreground="{StaticResource Muted}"/>
              <TextBlock x:Name="Detail" Text="Импортируйте профиль, чтобы подключиться." TextAlignment="Center" TextWrapping="Wrap"
                         Foreground="{StaticResource Muted}" Margin="0,8,0,0"/>
            </StackPanel>
          </Border>
          <Border x:Name="ServersPanel" Grid.Column="1" Style="{StaticResource Panel}">
            <StackPanel>
              <TextBlock Text="Серверы" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,10"/>
              <Grid MinHeight="151">
                <ListBox x:Name="Servers" DisplayMemberPath="DisplayName" SelectionChanged="SelectionChanged"
                         AutomationProperties.Name="Серверы" Background="#37141E2D" BorderBrush="{StaticResource Border}" Padding="5" MaxHeight="213"/>
                <TextBlock x:Name="EmptyServers" Text="Здесь появятся импортированные профили" TextWrapping="Wrap" TextAlignment="Center"
                           Foreground="{StaticResource Muted}" IsHitTestVisible="False" VerticalAlignment="Center" Margin="13"/>
              </Grid>
              <WrapPanel Margin="0,11,0,0">
                <Button x:Name="Paste" Content="Вставить VLESS" Click="PasteClick" Margin="0,0,7,7"/>
                <Button x:Name="Import" Content="Открыть файл" Click="ImportClick" Margin="0,0,7,7"/>
                <Button x:Name="Subscribe" Content="Подписка HTTPS" Click="SubscribeClick" Margin="0,0,0,7"/>
                <Button x:Name="Rename" Content="Переименовать" Click="RenameClick" Margin="0,0,7,7"/>
                <Button x:Name="Remove" Content="Удалить" Click="RemoveClick" Margin="0,0,7,7"/>
                <Button x:Name="Latency" Content="Измерить задержку" Click="LatencyClick" Margin="0,0,0,7"/>
              </WrapPanel>
              <TextBlock x:Name="LatencyText" Text="Задержка измеряется по TCP до сервера." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,0"/>
            </StackPanel>
          </Border>
        </Grid>
        <Border Style="{StaticResource Panel}" Margin="0,15,0,0" Padding="16,12">
          <StackPanel>
            <DockPanel>
              <Button x:Name="Verify" DockPanel.Dock="Right" Content="Проверить соединение" Click="VerifyClick" Margin="8,0,0,0"/>
              <TextBlock Text="Диагностика" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </DockPanel>
            <Expander x:Name="DiagnosticsPanel" Foreground="{StaticResource Text}" Header="Результаты проверок и журнал" Margin="0,9,0,0">
              <StackPanel Margin="0,9,0,0">
                <WrapPanel Margin="0,0,0,9">
                  <TextBlock x:Name="CoreCheck" Margin="0,0,14,4"/><TextBlock x:Name="ProxyCheck" Margin="0,0,14,4"/>
                  <TextBlock x:Name="TrafficCheck" Margin="0,0,14,4"/><TextBlock x:Name="SystemCheck" Margin="0,0,0,4"/>
                </WrapPanel>
                <TextBlock x:Name="TunCheck" TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,0,0,5"/>
                <TextBlock x:Name="ExternalCheck" TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,0,0,5"/>
                <TextBlock x:Name="CheckedAt" TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,0,0,8"/>
                <TextBox x:Name="LogBox" AutomationProperties.Name="Журнал событий" Padding="8" Height="108"
                         IsReadOnly="True" IsReadOnlyCaretVisible="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                         Background="#60152131" Foreground="{StaticResource Text}" BorderBrush="{StaticResource Border}"/>
                <Button Content="Экспорт отчёта" HorizontalAlignment="Left" Click="ExportClick" Margin="0,9,0,0"/>
              </StackPanel>
            </Expander>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</Window>
